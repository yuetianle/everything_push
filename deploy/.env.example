POSTGRES_PASSWORD=改成强密码
ADMIN_PASSWORD=cargo run --bin pwd_hash -- 你的密码 输出的哈希
WECOM_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY=socks5://host.docker.internal:1080
SCRAPE_INTERVAL_SECS=180
# Docker Hub 用户名：填写后 ./deploy.sh up 直接拉取 CI 构建的镜像（不在本机编译）；留空则本机构建
DOCKERHUB_USERNAME=
# 镜像标签（默认 latest；回滚可填 CI 里带 sha 的标签或版本号）
IMAGE_TAG=latest
